    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.16.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.0",
    "unocss": "^0.65.0",
    "vite": "^5.4.0",
