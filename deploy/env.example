# WWS Adviser 环境变量样例（8_SECURITY §9.3）
# 只含名称与说明，不含可用密钥。复制为 deploy/env.sh 并按需填写，严禁提交真实值。

# —— 启动必需 ——
export WWSE_ENV="prod"                       # prod 强制校验 WWSE_SESSION_SECRET 为安全值
export WWSE_EXPECTED_WORKERS="1"             # 单 worker（多 worker 启动即拒绝）
export WWSE_DATA_DIR="/data"                 # 持久卷（DB/Parquet/文档/报告/备份/锁）
export WWSE_SESSION_SECRET=""                # 【必填】高熵随机串，如 openssl rand -hex 32
export WWSE_STATIC_DIR="/app/static"         # PWA 产物（镜像内置）

# —— 外部凭据（只经 env 注入；SQLite 仅存引用名，API 返回掩码）——
export WWSE_MODEL_API_KEY=""                 # 模型 API Key（引用名固定 WWSE_MODEL_API_KEY）
export WWSE_SMTP_KEY=""                      # SMTP 授权码/密码（引用名固定 WWSE_SMTP_KEY）

# —— 数据源 / 模型 / 通知（供应商已确认：AKShare / OpenAI-compatible / SMTP 587-465）——
export WWSE_MARKET_DATA_SOURCE="akshare"     # stub | akshare
export WWSE_DOCUMENT_SOURCE="akshare"        # stub | akshare
export WWSE_MODEL_SOURCE="openai"            # stub | openai
export WWSE_MODEL_BASE_URL=""                # 例：https://dashscope.aliyuncs.com/compatible-mode/v1（国内直连）
                                              # 若模型走宿主本地代理：填容器可达地址（如 http://172.17.0.1:8317/v1，
                                              # 需在宿主放行 docker 网段到该端口），勿填 localhost（容器内指向自身）
export WWSE_MODEL_NAME=""                    # 例：qwen-plus / glm-4 / deepseek-chat
export WWSE_MODEL_TIMEOUT="90"               # 推理型模型跑报告 prompt 常超 30s，过短会误报 model_unavailable
export WWSE_NOTIFIER_SOURCE="smtp"           # stub | smtp
export WWSE_SMTP_HOST=""                     # 第三方 SMTP 服务商
export WWSE_SMTP_PORT="587"                  # 587 STARTTLS 或 465 SSL（避开 25 封锁）
export WWSE_SMTP_USER=""                     # 通常为发件邮箱
export WWSE_SMTP_FROM=""                     # 发件地址
export WWSE_SMTP_TO=""                       # 收件地址
export WWSE_SMTP_USE_TLS="1"

# —— 可调默认（非敏感可经 /settings PATCH 持久化，写审计）——
export WWSE_LOG_LEVEL="INFO"
export WWSE_EXECUTOR_POLL_SEC="30"           # 执行器轮询 job_runs 间隔
export WWSE_JOB_LEASE_TTL_SEC="300"
export WWSE_JOB_MAX_ATTEMPTS="3"
export WWSE_RISK_SINGLE_CAP="0.30"
export WWSE_RISK_INDUSTRY_CAP="0.40"
export WWSE_RISK_CASH_FLOOR="0.10"
export WWSE_RISK_TOP_N="5"
export WWSE_RISK_TOP_N_CONC="0.60"
export WWSE_NOTIFY_PRIVACY="1"               # 锁屏通知不含标的/金额/动作

# —— 构建标记（docker compose build 用，非运行时）——
export WWS_TAG=""                            # 镜像标签 = git commit 短 SHA（禁 latest）
