# 宿主 Nginx 反代样例（8_SECURITY §9.2/§11）：HTTPS 终结 + 安全头 + 登录限速 + 仅 443
# certbot 证书路径按实际域名替换；应用端口 127.0.0.1:8000（compose 仅回环暴露）。

limit_req_zone $binary_remote_addr zone=wws_login:10m rate=12r/m;  # 登录限速（叠加应用内 5/5min）

server {
    listen 80;
    server_name wws.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name wws.example.com;

    ssl_certificate     /etc/letsencrypt/live/wws.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wws.example.com/privkey.pem;

    # 安全头（8_SECURITY §4）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'" always;

    client_max_body_size 10m;  # CSV 上传上限

    location /api/v1/auth/login {
        limit_req zone=wws_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;      # SSE（Phase 2.2 /events）
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
